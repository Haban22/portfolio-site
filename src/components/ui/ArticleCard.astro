---
interface Props {
  title: string;
  description?: string;
  url: string;
  date?: Date;
  tags?: string[];
  target?: string;
  rel?: string;
}

const { title, description, url, date, tags, target, rel } = Astro.props;
import { formatDate } from "../../utils/date";

const isExternal = url.startsWith("http://") || url.startsWith("https://");
const linkTarget = target ?? (isExternal ? "_blank" : undefined);
const linkRel = rel ?? (isExternal ? "noopener noreferrer" : undefined);
---

<article>
  <div class="title-row">
    <a href={url} target={linkTarget} rel={linkRel}>{title}</a>
    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
  </div>
  <p class="muted-text">{description}</p>
  {
    tags && (
      <div class="tags">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    )
  }
</article>

<style>
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }

  .title-row a {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .title-row a {
    font-size: var(--text-lg);
    text-decoration: none;
    color: var(--text-color);
  }

  .title-row a:hover {
    color: var(--link-color);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tags span {
    font-size: var(--text-xs);
    opacity: 0.5;
  }
</style>
