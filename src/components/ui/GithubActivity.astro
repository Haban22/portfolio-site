---
interface Props {
  username: string;
}

const { username } = Astro.props;

type Day = { date: string; count: number; level: number };

async function fetchContributions(user: string): Promise<{ total: number; days: Day[] }> {
  // 1. Primary: Fetch directly from GitHub's contributions calendar (always up-to-date)
  try {
    const res = await fetch(`https://github.com/users/${user}/contributions`, {
      headers: {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
      },
    });
    if (res.ok) {
      const html = await res.text();
      const totalMatch = html.match(/([0-9,]+)\s+contributions\s+in the last year/);
      const total = totalMatch ? parseInt(totalMatch[1].replace(/,/g, "")) : 0;

      const tdRegex = /<td[^>]*class="[^"]*ContributionCalendar-day[^"]*"[^>]*>/g;
      const tds = html.match(tdRegex) || [];
      const parsed: Day[] = [];

      for (const td of tds) {
        const dateM = td.match(/data-date="([^"]+)"/);
        const levelM = td.match(/data-level="([^"]+)"/);
        const idM = td.match(/id="([^"]+)"/);

        let count = 0;
        if (idM) {
          const tipRegex = new RegExp(`for="${idM[1]}"[^>]*>([^<]+)<`, "i");
          const tipM = html.match(tipRegex);
          if (tipM) {
            const countM = tipM[1].match(/([0-9]+)\s+contribution/);
            if (countM) count = parseInt(countM[1]);
          }
        }

        if (dateM) {
          parsed.push({
            date: dateM[1],
            count: count,
            level: levelM ? parseInt(levelM[1]) : 0,
          });
        }
      }

      parsed.sort((a, b) => a.date.localeCompare(b.date));

      if (parsed.length > 0) {
        return { total, days: parsed };
      }
    }
  } catch (err) {
    console.warn("Direct GitHub fetch failed, attempting fallback API:", err);
  }

  // 2. Fallback: jogruber API
  try {
    const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${user}?y=last`);
    if (res.ok) {
      const data = await res.json();
      return {
        total: data.total?.lastYear ?? data.contributions.reduce((s: number, d: any) => s + (d.count || 0), 0),
        days: data.contributions || [],
      };
    }
  } catch (err) {
    console.error("GitHub contributions fallback failed:", err);
  }

  return { total: 0, days: [] };
}

const { total, days } = await fetchContributions(username);

// Pad the first week so each column starts on Sunday
const pad = days.length ? new Date(days[0].date + "T00:00:00Z").getUTCDay() : 0;
const cells: (Day | null)[] = [...Array(pad).fill(null), ...days];
---

{days.length > 0 && (
  <section class="activity">
    <div class="activity-header">
      <h2>GitHub Activity</h2>
      <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer">
        @{username}
      </a>
    </div>

    <div class="graph" role="img" aria-label={`${total} contributions in the last year`}>
      {cells.map((day) =>
        day ? (
          <span
            class="cell"
            data-level={day.level}
            title={`${day.count} contributions on ${day.date}`}
          />
        ) : (
          <span class="cell empty" />
        )
      )}
    </div>

    <p class="summary">{total} contributions in the last year</p>
  </section>
)}

<style>
  .activity {
    margin-bottom: 2.5rem;
  }

  .activity-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .activity-header h2 {
    margin: 0;
  }

  .graph {
    display: grid;
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 3px;
  }

  .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.06);
    transition: background-color var(--transition-base);
  }

  .cell.empty {
    background: none;
  }

  .cell[data-level="1"] { background: rgba(255, 255, 255, 0.18); }
  .cell[data-level="2"] { background: rgba(255, 255, 255, 0.32); }
  .cell[data-level="3"] { background: rgba(255, 255, 255, 0.5); }
  .cell[data-level="4"] { background: rgba(255, 255, 255, 0.75); }

  :global([data-theme="light"]) .cell {
    background: rgba(0, 0, 0, 0.06);
  }

  :global([data-theme="light"]) .cell.empty {
    background: none;
  }

  :global([data-theme="light"]) .cell[data-level="1"] { background: rgba(0, 0, 0, 0.18); }
  :global([data-theme="light"]) .cell[data-level="2"] { background: rgba(0, 0, 0, 0.35); }
  :global([data-theme="light"]) .cell[data-level="3"] { background: rgba(0, 0, 0, 0.55); }
  :global([data-theme="light"]) .cell[data-level="4"] { background: rgba(0, 0, 0, 0.8); }

  .summary {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
</style>
