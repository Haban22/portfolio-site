---
import Section from "../components/ui/Section.astro";
import { getCollection, getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../components/layout/BaseLayout.astro";
import ContentList from "../components/shared/ContentList.astro";
import Container from "../components/ui/Container.astro";
import SocialIcon from "../components/ui/SocialIcon.astro";

const siteConfig = await getEntry("site", "home");
if (!siteConfig) {
  throw new Error("Site configuration not found");
}

const site = siteConfig.data;

const formatDate = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
};

const formatPeriodDate = (date: Date | undefined) => {
  if (!date) return "";
  return date.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
  });
};

const posts = await getCollection("blog", ({ data }: CollectionEntry<"blog">) => {
  return import.meta.env.PROD ? !data.draft : true;
});
const latestPosts = posts
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
  )
  .slice(0, 3);

const experiences = await getCollection("experience");
const sortedExperiences = experiences.sort(
  (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
    b.data.startDate.getTime() - a.data.startDate.getTime()
);

const educationEntries = await getCollection("education");
const sortedEducation = educationEntries.sort(
  (a: CollectionEntry<"education">, b: CollectionEntry<"education">) =>
    b.data.startDate.getTime() - a.data.startDate.getTime()
);

const projects = await getCollection("projects");
const featuredProjects = projects.filter((project: CollectionEntry<"projects">) => project.data.featured).slice(0, 3);

const skillsEntries = await getCollection("skills");
const skills: string[] = skillsEntries.flatMap((entry: CollectionEntry<"skills">) => {
  if (entry.data.skills && entry.data.skills.length > 0) {
    return entry.data.skills;
  }
  if (entry.body) {
    return entry.body
      .split("\n")
      .map((line: string) => line.replace(/^[-*]\s+/, "").trim())
      .filter((s: string) => s.length > 0);
  }
  return entry.data.title ? [entry.data.title] : [];
});


---

<BaseLayout title={`${site.name} - Portfolio`} description={site.introduction}>
  <Container>
    <section class="hero">
      <h1>{site.name}</h1>
      <p class="subtitle">{site.title}</p>
      <p class="introduction">{site.introduction}</p>
      {
        site.socialLinks && (
          <div class="social-links">
            {site.socialLinks.filter((item) => item.url && item.url.trim().length > 0).map(({ platform, url }) => {
              const isEmail = platform.toLowerCase() === "email" || platform.toLowerCase() === "mail";
              const rawEmail = isEmail ? url.replace(/^mailto:/i, "").trim() : "";
              const href = isEmail && !url.startsWith("mailto:") ? `mailto:${url}` : url;
              const target = isEmail ? undefined : "_blank";
              const rel = isEmail ? undefined : "noopener noreferrer";
              if (isEmail) {
                return (
                  <div class="email-wrapper">
                    <a href={href} class="email-link" title={`Send email to ${rawEmail}`}>
                      <SocialIcon platform="email" />
                      <span>{rawEmail || "Email"}</span>
                    </a>
                    {rawEmail && (
                      <button
                        type="button"
                        class="copy-email-btn"
                        data-email={rawEmail}
                        aria-label="Copy email address"
                        title="Copy to clipboard"
                      >
                        <svg class="copy-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                        </svg>
                        <svg class="check-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span class="copy-tooltip">Copied!</span>
                      </button>
                    )}
                  </div>
                );
              }

              return (
                <a href={href} target={target} rel={rel}>
                <SocialIcon platform={platform} />
                <span>{platform}</span>
              </a>
              );
            })}
          </div>
        )
      }
    </section>

    <section class="section">
      <div class="section-header">
        <h2>{site.sections.experience.title}</h2>
        <a href="/experience">{site.sections.experience.viewAllText}</a>
      </div>
      <div class="content-list">
        {
          sortedExperiences.slice(0, 2).map((exp) => (
            <article>
              <div class="title-row">
                <div class="company-info">
                  <img src={exp.data.logo} alt="" class="company-logo" />
                  <span>{exp.data.title}</span>
                </div>
                <time>
                  {formatPeriodDate(exp.data.startDate)} - {exp.data.current ? "Present" : formatPeriodDate(exp.data.endDate)}
                </time>
              </div>
              <p class="muted-text">{exp.data.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>{site.sections.education?.title ?? "Education"}</h2>
        {site.sections.education?.viewAllText && (
          <a href="/education">{site.sections.education.viewAllText}</a>
        )}
      </div>
      <div class="content-list">
        {
          sortedEducation.map((edu) => (
            <article>
              <div class="title-row">
                <div class="company-info">
                  {edu.data.logo && <img src={edu.data.logo} alt="" class="company-logo" />}
                  <span>{edu.data.title}</span>
                </div>
                <time>
                  {formatPeriodDate(edu.data.startDate)} - {edu.data.current ? "Present" : formatPeriodDate(edu.data.endDate)}
                </time>
              </div>
              <p class="muted-text">{edu.data.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>{site.sections.projects.title}</h2>
        <a href="/projects">{site.sections.projects.viewAllText}</a>
      </div>
      <ContentList>
        {
          featuredProjects.map((project) => (
            <article>
              <div class="title-row">
                <a href={project.data.url} target="_blank" rel="noopener noreferrer">
                  {project.data.title}
                </a>
              </div>
              <p class="muted-text">{project.data.description}</p>
              {project.data.techs && (
                <div class="tags">
                  {project.data.techs.map((tech) => (
                    <span>{tech}</span>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </ContentList>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Skills</h2>
      </div>
      <div class="skills-grid">
        {
          skills.map((skill) => (
            <div class="skill-item">
              <span>{skill}</span>
            </div>
          ))
        }
      </div>
    </section>

    <Section>
      <div class="section-header">
        <h2>{site.sections.blog.title}</h2>
        <a href="/blog">{site.sections.blog.viewAllText}</a>
      </div>
      <ContentList>
        {
          latestPosts.map((post) => (
            <article>
              <div class="title-row">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                {post.data.publishedAt && (
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                )}
              </div>
              <p class="muted-text">{post.data.description}</p>
            </article>
          ))
        }
      </ContentList>
    </Section>

  </Container>
</BaseLayout>

<style>
  main {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .hero {
    padding: 4rem 0;
  }

  .introduction {
    margin: 1.5rem 0;
    opacity: 0.9;
  }

  .section {
    margin: 4rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    opacity: 0.7;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--text-sm);
  }

  .company-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .company-logo {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }

  time {
    font-size: var(--text-xs);
    opacity: 0.5;
    white-space: nowrap;
  }

  .tags {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .tags span {
    font-size: var(--text-xs);
    opacity: 0.5;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    opacity: 0.7;
  }

  .email-wrapper {
    display: inline-flex;
    align-items: center;
    position: relative;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 0.15rem 0.35rem 0.15rem 0.6rem;
    gap: 0.35rem;
    transition: border-color var(--transition-base), background var(--transition-base);
  }

  .email-wrapper:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.07);
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-color);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .copy-email-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    margin: 0;
    border: none;
    background: transparent;
    color: var(--text-muted);
    border-radius: 9999px;
    cursor: pointer;
    position: relative;
    transition: color var(--transition-base), background-color var(--transition-base);
  }

  .copy-email-btn:hover {
    color: var(--text-color);
    background: rgba(255, 255, 255, 0.1);
  }

  .copy-email-btn.copied {
    color: #4ade80;
  }

  .copy-email-btn.copied .copy-icon {
    display: none;
  }

  .copy-email-btn.copied .check-icon {
    display: inline-block !important;
  }

  .copy-tooltip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    background: #1f2937;
    color: #f3f4f6;
    border: 1px solid var(--border-color);
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 0.375rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease, transform 0.15s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  .copy-email-btn.copied .copy-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(95px, 1fr));
    gap: 0.5rem;
  }

  .skill-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.65rem;
    background: var(--hover-bg);
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    font-size: var(--text-xs);
    color: var(--text-color);
    letter-spacing: -0.01em;
    text-align: center;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .skill-item:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem 0;
    }

    .hero {
      padding: 3rem 0;
    }

    .skills-grid {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 0.375rem;
    }

    .skill-item {
      padding: 0.35rem 0.5rem;
      font-size: 0.7rem;
    }

    .container {
      padding: 0 1rem;
    }
  }
</style>

<script>
  function setupEmailCopy() {
    const buttons = document.querySelectorAll(".copy-email-btn");
    buttons.forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const email = btn.getAttribute("data-email");
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          btn.classList.add("copied");
          setTimeout(() => {
            btn.classList.remove("copied");
          }, 2000);
        } catch (err) {
          console.error("Failed to copy:", err);
        }
      });
    });
  }

  setupEmailCopy();
  document.addEventListener("astro:page-load", setupEmailCopy);
</script>
